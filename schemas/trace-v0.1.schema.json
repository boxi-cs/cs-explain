{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxi-cs.github.io/cs-explain/schemas/trace-v0.1.schema.json",
  "title": "Boxi CS executable explanation trace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "title", "seed", "source", "events", "assertions", "text_fallback"],
  "properties": {
    "schema_version": {"const": "trace/v0.1"},
    "trace_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "source": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "text_fallback": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sourceSpan": {
      "type": "object", "additionalProperties": false, "required": ["file", "line"],
      "properties": {"file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "logical_time", "actor", "operation", "source_span", "state_delta", "observation", "causal_parents", "assertions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "logical_time": {"type": "integer", "minimum": 0},
        "actor": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "state_delta": {"type": "object"},
        "observation": {"type": "string", "minLength": 1},
        "causal_parents": {"type": "array", "items": {"type": "string"}},
        "assertions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "description", "event_id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
